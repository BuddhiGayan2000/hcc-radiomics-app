# Copy this file to `.env` and adjust as needed. All values shown are the
# local-development defaults — nothing here needs to change to run locally.

# Comma-separated list of frontend origins allowed to call this API (CORS).
# The Vite dev server defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# Host/port the API listens on.
API_HOST=127.0.0.1
API_PORT=8000

# "development" enables auto-reload; "production" disables it.
# (There is no separate production deployment in this project — see README.)
ENV=development
